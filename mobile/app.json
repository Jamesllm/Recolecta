{
  "expo": {
    "name": "Recolecta+",
    "slug": "recolecta-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.recolectaplus.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ECFDF5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pe.recolectaplus.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-status-bar",
        {
          "style": "dark",
          "hidden": false
        }
      ],
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Recolecta+ usa la cámara para tomar la foto de los residuos que reportas.",
          "photosPermission": "Recolecta+ accede a tus fotos para adjuntar la evidencia del reporte.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Recolecta+ usa tu ubicación para registrar dónde están los residuos y mostrar los reportes cercanos."
        }
      ]
    ],
    "scheme": "recolectaplus",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#FFFFFF"
  }
}
