{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 4000,
      "cwd": "backend"
    },
    {
      "name": "panel",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "cwd": "frontend"
    },
    {
      "name": "app-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081,
      "cwd": "mobile"
    },
    {
      "name": "app-web-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082,
      "cwd": "mobile",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:4000/api"
      }
    }
  ]
}