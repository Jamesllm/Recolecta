# Variables de docker-compose.yml. Copiar a .env (no se sube al repositorio) y completar.

# Obligatorio: base de datos PostgreSQL con PostGIS en Neon (Dashboard de Neon › Connect › cadena de conexión)
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST.neon.tech/recolecta?sslmode=require&channel_binding=require

# Obligatorio: firma de las sesiones. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Dirección con la que el navegador y los teléfonos llegan a la PC.
# «localhost» basta en la misma PC; para abrir el panel o la app desde el teléfono, la IP de la PC en la red Wi-Fi.
# Si se cambia, reconstruir: docker compose up --build
PUBLIC_HOST=localhost

# Fotos de evidencia: s3 (almacenamiento compatible con S3) o local (volumen de Docker)
STORAGE_DRIVER=local
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Correo (recuperar contraseña, bienvenida y reporte resuelto). Con Gmail: smtp.gmail.com, 465 y una contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Recolecta+ <no-responder@recolecta.pe>"

# Rutas por calles: vacío usa el servidor público de OSRM (demostración)
OSRM_URL=
